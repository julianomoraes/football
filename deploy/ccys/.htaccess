# Upload this file into the /schedulev2/ folder itself (not the WordPress
# root). It tells Apache to serve 404.html — with a 404 status, but the
# browser's address bar keeps the originally requested URL — for any pretty
# URL under /schedulev2/ that isn't a real file (e.g. /schedulev2/CCW/12U).
ErrorDocument 404 /schedulev2/404.html
